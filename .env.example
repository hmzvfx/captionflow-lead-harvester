# Required for YouTube discovery (free quota)
YOUTUBE_API_KEY=

# Required for Google Sheets persistence
GOOGLE_SPREADSHEET_ID=

# Targeting
WORKER_COUNT=20
TARGET_LANGUAGES=fr
TARGET_COUNTRIES=BE,FR,CA,CH
TARGET_NICHES=business,fitness,marketing,coaching,real_estate,finance
CREATOR_TYPES=coach,consultant,formateur,entrepreneur,creator,podcast
MIN_SUBSCRIBERS=500
MAX_SUBSCRIBERS=500000
RECENT_DAYS=45
MIN_SCORE=55
HOT_SCORE=80
GOOD_SCORE=65
POSSIBLE_SCORE=50
TARGET_PROSPECTS_PER_RUN=500

# Conservative per-run budgets
MAX_YOUTUBE_REQUESTS_PER_RUN=20
MAX_YOUTUBE_SEARCH_REQUESTS_PER_RUN=3
MAX_WEBSITES_PER_RUN=120
MAX_PAGES_PER_DOMAIN=5
MAX_ENRICHMENTS_PER_RUN=120
MAX_RUNTIME_MINUTES=40
MAX_PAGE_BYTES=1500000
HTTP_TIMEOUT_SECONDS=12
PER_HOST_DELAY_SECONDS=0.6

# Optional free/public sources, comma-separated
PUBLIC_SEED_URLS=
PUBLIC_FEED_URLS=
PUBLIC_SITEMAP_URLS=

# Disabled by design; core never requires a paid LLM
LLM_ENABLED=false
HARVESTER_USER_AGENT=CaptionflowLeadHarvester/1.0 (+public-contact-discovery)
